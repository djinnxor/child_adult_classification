# ── Dockerfile.label_person ──────────────────────────────────────────────────
# Runs label_person.py inside Docker with X11 display forwarding.
#
# Build:
#   docker build -f Dockerfile.label_person -t label-person .
#
# Run (Linux host):
#   ./docker-run-label.sh --images_dir /data/frames
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.12-slim

# System libs required by OpenCV GUI (X11 / GTK) and cv2 headless fallback
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libx11-6 \
        libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies (headless opencv is fine; GUI is provided via X11)
RUN pip install --no-cache-dir \
        "opencv-python-headless>=4.8.0" \
        "numpy>=1.24.0"

COPY label_person.py .

# /data is the mount point for the host images/labels directory
VOLUME ["/data"]

ENTRYPOINT ["python", "label_person.py"]
# Default: images_dir points to /data; override at runtime with --images_dir / --labels_dir
CMD ["--images_dir", "/data"]
